void updateCrashSnapshot() {
  g_crashReport.magic = CRASH_REPORT_MAGIC;
  g_crashReport.bootCount = g_bootCount;
  if (xSemaphoreTake(xCounterMutex, 0) == pdTRUE) {
    g_crashReport.counterValue = counterBlock.count;
    g_crashReport.counterSequence = counterBlock.sequence;
    xSemaphoreGive(xCounterMutex);
  }
  g_crashReport.freeHeap = heap_caps_get_free_size(MALLOC_CAP_INTERNAL);
  g_crashReport.minFreeHeap = heap_caps_get_minimum_free_size(MALLOC_CAP_INTERNAL);
  g_crashReport.largestFreeBlock = heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL);
  g_crashReport.uptimeMs = millis();
  g_crashReport.lastFirebaseUploadMs = g_lastFirebaseUploadMs;
  g_crashReport.lastNvsSaveMs = g_lastNvsSaveMs;
  g_crashReport.lastHttpLogMs = g_lastHttpLogMs;
  g_crashReport.lastRtcReadMs = g_lastRtcReadMs;
  g_crashReport.lastWifiConnectMs = g_lastWifiConnectMs;
  g_crashReport.wifiConnected = g_wifiConnected;
  g_crashReport.mutexTimeoutSeen = g_mutexTimeoutSeen;
  g_crashReport.queueOverflowSeen = g_queueOverflowSeen;
  g_crashReport.crc = calculateCRC32((uint8_t*)&g_crashReport.bootCount, sizeof(CrashReport) - (2 * sizeof(uint32_t)));
}

