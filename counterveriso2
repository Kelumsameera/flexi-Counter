void vFirebaseTask(void *pvParameters) {
  uint32_t lastProcessedSeq = 0;
  
  // බෝඩ් එක On වූ පසු පළමු වරට Wi-Fi ලැබුණු වහාම ටෝකන් එක ලබා ගැනීමට උත්සාහ කිරීම
  while (g_wifiConnected && g_firebaseCustomToken == "") {
    dispatchLog("AUTH_ATTEMPT", "Fetching initial Firebase custom token...");
    if (executeCustomTokenTransaction()) {
      dispatchLog("AUTH_SUCCESS", "Initial Firebase custom token acquired successfully.");
      break;
    }
    vTaskDelay(pdMS_TO_TICKS(3000)); // අසාර්ථක වුවහොත් තත්පර 3 කින් නැවත උත්සාහ කරයි
  }

  for (;;) {
    if (g_wifiConnected && Firebase.ready()) {
      
      // අලුතින් එක් කරන ලද ස්ථානය: ඔෆ්ලයින් දත්ත යැවීම මෙහිදී සිදුවේ.
      syncOfflineData();
      
      uint32_t workingCount = 0; uint32_t workingSeq = 0; bool targetAcquired = false;
      if (xSemaphoreTake(xCounterMutex, pdMS_TO_TICKS(100)) == pdTRUE) {
        if (counterBlock.sequence != lastProcessedSeq) {
          workingCount = counterBlock.count; workingSeq = counterBlock.sequence; targetAcquired = true;
        }
        xSemaphoreGive(xCounterMutex);
      }
      
      if (targetAcquired) {
        char timeFormatted[32] = "2026/01/01 00:00:00";
        uint32_t currentTimestamp = 0;
        
        if (g_rtcAvailable) {
          DateTime now = rtc.now();
          snprintf(timeFormatted, sizeof(timeFormatted), "%04d/%02d/%02d %02d:%02d:%02d", 
                   now.year(), now.month(), now.day(), now.hour(), now.minute(), now.second());
          currentTimestamp = now.unixtime();
        }
        
        // අලුත් ආකෘතියට අනුව JSON සකස් කිරීම
        FirebaseJson payloadJson;
        payloadJson.set("Count", workingCount); 
        payloadJson.set("Time", timeFormatted); 
        payloadJson.set("timestamp", currentTimestamp);
        
        // LiveStatus එක Update කිරීම
        if (Firebase.RTDB.setJSON(fbdo, g_liveStatusPath, &payloadJson)) {
          g_lastFirebaseUploadMs = millis();
          lastProcessedSeq = workingSeq;
          
          // CounterHistory සඳහා push() මඟින් අද්විතීය ID එකක් යටතේ සටහන් කිරීම
          Firebase.RTDB.push(fbdo, g_historyPath, &payloadJson);
        } else {
          enqueueOfflinePayload(workingCount, workingSeq, timeFormatted, currentTimestamp);
          lastProcessedSeq = workingSeq;
        }
      }
    } else if (g_wifiConnected && !g_authInProgress) {
      unsigned long currentMs = millis();
      if (currentMs - g_lastTokenFetchAttemptMs >= g_tokenFetchBackoffMs) {
        g_authInProgress = true;
        g_lastTokenFetchAttemptMs = currentMs;
        unsigned long nextBackoff = (g_tokenFetchBackoffMs * 2);
        
        if (executeCustomTokenTransaction()) {
          g_tokenFetchBackoffMs = 2000UL; 
          dispatchLog("AUTH_REFRESH", "Firebase custom token refreshed successfully.");
        } else {
          g_tokenFetchBackoffMs = (nextBackoff < TOKEN_FETCH_BACKOFF_MAX_MS) ? nextBackoff : TOKEN_FETCH_BACKOFF_MAX_MS;
        }
        g_authInProgress = false;
      }
    }
    vTaskDelay(pdMS_TO_TICKS(500));
  }
}

void vBackgroundTask(void *pvParameters) {
  unsigned long lastWifiCheckMs = 0;
  for (;;) {
    unsigned long now = millis();
    
    if (WiFi.status() == WL_CONNECTED) {
      if (!g_wifiConnected) {
        g_wifiConnected = 1; g_lastWifiConnectMs = now;
        dispatchLog("NET_CONNECT", "WiFi path connection successfully unified.");
        
        // Wi-Fi Reconnect වූ විටද වේලාව යාවත්කාලීන කර ගැනීම සඳහා
        syncTimeFromNTP(); 
      }
    } else {
      g_wifiConnected = 0;
      if (now - lastWifiCheckMs >= WIFI_RECONNECT_BACKOFF_MS) {
        lastWifiCheckMs = now; WiFi.disconnect(); WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
      }
    }
    
    // ඉවත් කරන ලද ස්ථානය: syncOfflineData() මෙතැනින් ඉවත් කර ඇත.
    
    uint32_t cVal = 0, cSeq = 0;
    if (xSemaphoreTake(xCounterMutex, pdMS_TO_TICKS(50)) == pdTRUE) { cVal = counterBlock.count; cSeq = counterBlock.sequence; xSemaphoreGive(xCounterMutex); }
    
    uint32_t diff = (cVal >= g_lastSavedCount) ? (cVal - g_lastSavedCount) : cVal;
    if (diff >= NVS_SAVE_COUNT_THRESHOLD || (now - g_lastNvsSaveTimeMs >= NVS_SAVE_MAX_INTERVAL_MS && cVal != g_lastSavedCount)) {
      saveCounterBlockToNVS(cVal, cSeq);
    }
    
    if (g_canaryFront != CANARY_FRONT_VAL || g_canaryBack != CANARY_BACK_VAL) {
      saveCounterBlockToNVS(cVal, cSeq); esp_restart(); 
    }
    updateCrashSnapshot();
    vTaskDelay(pdMS_TO_TICKS(1000));
  }
}

void vLogTask(void *pvParameters) {
  LogMessage outgoingPacket;
  WiFiClientSecure client; client.setInsecure();
  
  for (;;) {
    if (xQueueReceive(xLogQueue, &outgoingPacket, pdMS_TO_TICKS(500)) == pdTRUE) {
      Serial.printf("[%s] %s\n", outgoingPacket.eventType, outgoingPacket.message);
      if (g_wifiConnected) {
        HTTPClient http;
        if (http.begin(client, mongoLogApiUrl)) {
          http.addHeader("Content-Type", "application/json");
          http.addHeader("User-Agent", "ESP32-S3-Hardened/11.0");
          http.addHeader("X-Device-ID", g_deviceIdBuf);
          http.addHeader("Authorization", String("Bearer ") + DEVICE_SECRET);

          JsonDocument outDoc;
          outDoc["deviceId"] = g_deviceIdBuf; outDoc["eventType"] = outgoingPacket.eventType;
          outDoc["message"] = outgoingPacket.message; outDoc["timestamp"] = millis();
          
          String body; serializeJson(outDoc, body);
          int code = http.POST(body);
          if (code == HTTP_CODE_OK || code == HTTP_CODE_CREATED) g_lastHttpLogMs = millis();
          http.end();
        }
      }
    }
  }
}

// ================= COLD START SYSTEM INITIALIZER (STAGGERED BOOT) =================
void setup() {
  Serial.begin(115200);
  delay(1000); 
  
  Serial.println("\n--- SYSTEM BOOTING ---");

  Serial.print("Connecting to Wi-Fi...");
  WiFi.mode(WIFI_STA);
  WiFi.disconnect();
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println("\nWi-Fi Connected!");
  Serial.println(WiFi.localIP());
  
  delay(500); 
  Wire.begin(8, 9);
  lcd.init(); lcd.backlight(); lcd.clear(); g_lcdAvailable = true;
  
  delay(200);
  if (rtc.begin()) g_rtcAvailable = true;
  
  delay(200);
  if (!LittleFS.begin(true)) {
    Serial.println("LittleFS Mounting Failure. Please check Partition Scheme.");
  } else {
    Serial.println("LittleFS Mounted Successfully.");
  }
  
  delay(200);
  fbdo = new FirebaseData();
  fbdoSync = new FirebaseData();
  auth = new FirebaseAuth();
  config = new FirebaseConfig();
  
  xCounterMutex = xSemaphoreCreateMutex();
  xLogQueue = xQueueCreate(30, sizeof(LogMessage));
  
  recoverCounterState();

  // Wi-Fi සම්පූර්ණයෙන්ම ස්ථාපිත වීමට තත්පර 2ක් ලබා දීම
  delay(2000); 

  // ---> අලුතින් එක් කළ NTP Time Sync කිරීම <---
  syncTimeFromNTP();

  // ---> අලුත් Firebase Paths (Machines යටතට මාරු කර ඇත) <---
  snprintf(g_basePath, sizeof(g_basePath), "/Machines/%s", g_deviceIdBuf);
  snprintf(g_liveStatusPath, sizeof(g_liveStatusPath), "%s/LiveStatus", g_basePath);
  snprintf(g_historyPath, sizeof(g_historyPath), "%s/CounterHistory", g_basePath);
  
  config->api_key = FIREBASE_API_KEY;
  config->database_url = FIREBASE_DATABASE_URL;
  Firebase.begin(config, auth);
  Firebase.reconnectWiFi(false);
  
  delay(200);
  pinMode(SENSOR_PIN, INPUT_PULLUP);
  pinMode(RESET_BUTTON_PIN, INPUT_PULLDOWN); // Active-HIGH
  attachInterrupt(digitalPinToInterrupt(SENSOR_PIN), sensorISR, FALLING);
  
  // ---> අලුතින් වෙනස් කරන ලද Stack ප්‍රමාණයන් <---
  xTaskCreatePinnedToCore(vSensorTask,     "SensorTsk",  4096,  NULL, 4, &hSensorTask,     0);
  xTaskCreatePinnedToCore(vDisplayTask,    "DispTsk",    4096,  NULL, 1, &hDisplayTask,    0);
  xTaskCreatePinnedToCore(vFirebaseTask,   "FBTask",     10240, NULL, 2, &hFirebaseTask,   1); // Stack size වැඩි කර ඇත
  xTaskCreatePinnedToCore(vBackgroundTask, "BgTask",     8192,  NULL, 2, &hBackgroundTask, 1); // Stack size වැඩි කර ඇත
  xTaskCreatePinnedToCore(vLogTask,        "LogTask",    8192,  NULL, 1, &hLogTask,        1);
  
  dispatchLog("BOOT_SEQUENCE", "System initialized successfully via staggered boot.");
  Serial.println("--- SYSTEM FULLY STARTED ---");
}

void loop() {
  vTaskDelete(NULL);
}
