void saveCounterBlockToNVS(uint32_t finalCount, uint32_t finalSeq) {
  Preferences prefs;
  if (!prefs.begin("factory_sys", false)) return;
  NVSRecord record;
  record.magic = NVS_RECORD_MAGIC;
  record.count = finalCount;
  record.seq = finalSeq;
  record.crc = calculateCRC32((uint8_t*)&record.count, sizeof(record.count) + sizeof(record.seq));
  prefs.putBytes("rec_copy_a", &record, sizeof(NVSRecord));
  prefs.putBytes("rec_copy_b", &record, sizeof(NVSRecord));
  prefs.end();
  g_lastSavedCount = finalCount;
  g_lastNvsSaveTimeMs = millis();
  g_lastNvsSaveMs = (uint32_t)g_lastNvsSaveTimeMs;
}

void recoverCounterState() {
  Preferences prefs;
  bool validA = false, validB = false;
  NVSRecord recA, recB;
  if (prefs.begin("factory_sys", true)) {
    if (prefs.getBytes("rec_copy_a", &recA, sizeof(NVSRecord)) == sizeof(NVSRecord)) {
      if (recA.magic == NVS_RECORD_MAGIC && recA.crc == calculateCRC32((uint8_t*)&recA.count, sizeof(recA.count) + sizeof(recA.seq))) validA = true;
    }
    if (prefs.getBytes("rec_copy_b", &recB, sizeof(NVSRecord)) == sizeof(NVSRecord)) {
      if (recB.magic == NVS_RECORD_MAGIC && recB.crc == calculateCRC32((uint8_t*)&recB.count, sizeof(recB.count) + sizeof(recB.seq))) validB = true;
    }
    g_bootCount = prefs.getUInt("boot_count", 0) + 1;
    prefs.end();
  } else {
    g_bootCount = 1;
  }

  if (prefs.begin("factory_sys", false)) {
    prefs.putUInt("boot_count", g_bootCount);
    prefs.end();
  }

  counterBlock.guardFront = GUARD_FRONT_MAGIC;
  counterBlock.guardBack = GUARD_BACK_MAGIC;

  if (validA && validB) {
    if (recA.seq >= recB.seq) { counterBlock.count = recA.count; counterBlock.sequence = recA.seq; } 
    else { counterBlock.count = recB.count; counterBlock.sequence = recB.seq; }
  } else if (validA) {
    counterBlock.count = recA.count; counterBlock.sequence = recA.seq;
  } else if (validB) {
    counterBlock.count = recB.count; counterBlock.sequence = recB.seq;
  } else {
    counterBlock.count = 0; counterBlock.sequence = 0;
  }
  updateCounterBlockCRC();
  g_lastSavedCount = counterBlock.count;
}

void enqueueOfflinePayload(uint32_t val, uint32_t seq, const char* timeStr, uint32_t unixTime) {
  if (!LittleFS.exists("/queue")) LittleFS.mkdir("/queue");
  char filename[32];
  snprintf(filename, sizeof(filename), "/queue/%u.json", seq);
  File f = LittleFS.open(filename, FILE_WRITE);
  if (f) {
    JsonDocument doc;
    doc["Count"] = val; 
    doc["sequence"] = seq; 
    doc["Time"] = timeStr; 
    doc["timestamp"] = unixTime;
    serializeJson(doc, f);
    f.close();
  }
}

bool executeCustomTokenTransaction() {
  if (WiFi.status() != WL_CONNECTED) return false;
  WiFiClientSecure client;
  client.setInsecure();
  HTTPClient http;
  if (!http.begin(client, backendTokenUrl)) return false;
  
  http.addHeader("Content-Type", "application/json");
  http.addHeader("User-Agent", "ESP32-S3-Hardened/11.0");
  http.addHeader("X-Device-ID", g_deviceIdBuf);
  http.addHeader("Authorization", String("Bearer ") + DEVICE_SECRET);

  JsonDocument outDoc;
  outDoc["deviceId"] = g_deviceIdBuf;
  outDoc["secret"] = DEVICE_SECRET;
  
  String reqPayload;
  serializeJson(outDoc, reqPayload);
  int code = http.POST(reqPayload);
  bool success = false;
  
  if (code == HTTP_CODE_OK) {
    String resp = http.getString();
    JsonDocument inDoc;
    DeserializationError err = deserializeJson(inDoc, resp);
    if (!err && inDoc.containsKey("token")) {
      g_firebaseCustomToken = inDoc["token"].as<String>();
      Firebase.setCustomToken(config, g_firebaseCustomToken.c_str());
      success = true;
    }
  }
  http.end();
  return success;
}

void syncOfflineData() {
  if (!LittleFS.exists("/queue")) return;
  File root = LittleFS.open("/queue");
  if (!root || !root.isDirectory()) return;
  
  File f = root.openNextFile();
  while (f) {
    if (!g_wifiConnected || !Firebase.ready()) { f.close(); break; }
    
    String path = f.path();
    if (!f.isDirectory() && path.endsWith(".json")) {
      String payload = f.readString();
      JsonDocument doc;
      DeserializationError err = deserializeJson(doc, payload);
      if (!err) {
        FirebaseJson syncJson;
        syncJson.set("Count", doc["Count"].as<uint32_t>());
        syncJson.set("Time", doc["Time"].as<const char*>());
        syncJson.set("timestamp", doc["timestamp"].as<uint32_t>());
        
        // ඔෆ්ලයින් දත්ත ද push() හරහා යැවීම
        if (Firebase.RTDB.push(fbdoSync, g_historyPath, &syncJson)) {
          f.close(); LittleFS.remove(path); root = LittleFS.open("/queue"); f = root.openNextFile(); continue;
        }
      }
    }
    f.close(); f = root.openNextFile();
  }
}

void vSensorTask(void *pvParameters) {
  unsigned long buttonHoldStartMs = 0;
  bool buttonActive = false;
  for (;;) {
    if (g_isrSensorFlag) {
      g_isrSensorFlag = false;
      if (xSemaphoreTake(xCounterMutex, pdMS_TO_TICKS(100)) == pdTRUE) {
        if (verifyCounterBlockCRC()) {
          counterBlock.count++; counterBlock.sequence++; updateCounterBlockCRC();
          dispatchLog("SENSOR_TRIGGER", "Counter advanced atomically via interrupt edge.");
        } else {
          dispatchLog("CRITICAL_CRC", "Memory integrity failure caught on process step.");
        }
        xSemaphoreGive(xCounterMutex);
      } else g_mutexTimeoutSeen = 1;
    }
    
    if (digitalRead(RESET_BUTTON_PIN) == HIGH) { 
      if (!buttonActive) { buttonActive = true; buttonHoldStartMs = millis(); } 
      else if (millis() - buttonHoldStartMs >= RESET_HOLD_MS) {
        if (xSemaphoreTake(xCounterMutex, pdMS_TO_TICKS(200)) == pdTRUE) {
          counterBlock.count = 0; counterBlock.sequence++; updateCounterBlockCRC();
          saveCounterBlockToNVS(0, counterBlock.sequence);
          xSemaphoreGive(xCounterMutex);
          dispatchLog("RESET_EVENT", "Counter wiped back to zero by manual physical button hold.");
        }
        buttonActive = false; 
        while(digitalRead(RESET_BUTTON_PIN) == HIGH) { vTaskDelay(pdMS_TO_TICKS(50)); } 
      }
    } else buttonActive = false;
    vTaskDelay(pdMS_TO_TICKS(10));
  }
}

