uint32_t calculateCRC32(const uint8_t *data, size_t length) {
  uint32_t crc = 0xFFFFFFFFUL;
  for (size_t i = 0; i < length; i++) {
    crc ^= data[i];
    for (int j = 0; j < 8; j++) {
      if (crc & 1) crc = (crc >> 1) ^ 0xEDB88320UL;
      else crc >>= 1;
    }
  }
  return ~crc;
}

void updateCounterBlockCRC() {
  counterBlock.crc32 = calculateCRC32((uint8_t*)&counterBlock.count, sizeof(counterBlock.count) + sizeof(counterBlock.sequence));
}

bool verifyCounterBlockCRC() {
  uint32_t calc = calculateCRC32((uint8_t*)&counterBlock.count, sizeof(counterBlock.count) + sizeof(counterBlock.sequence));
  return (calc == counterBlock.crc32);
}

void dispatchLog(const char* type, const char* msg) {
  LogMessage packet;
  snprintf(packet.eventType, sizeof(packet.eventType), "%s", type);
  snprintf(packet.message, sizeof(packet.message), "%s", msg);
  if (xLogQueue != NULL) {
    if (xQueueSend(xLogQueue, &packet, 0) != pdPASS) {
      g_queueOverflowSeen = 1;
    }
  }
}

// ================= අලුතින් යාවත්කාලීන කළ NTP Sync Function එක =================
void syncTimeFromNTP() {
  if (WiFi.status() == WL_CONNECTED) {
    // Servers 3ක් ලබා දී ඇත
    configTime(gmtOffset_sec, daylightOffset_sec, "pool.ntp.org", "time.google.com", "time.windows.com");
    
    struct tm timeinfo;
    bool time_synced = false;
    
    // අන්තර්ජාලයෙන් වේලාව ලබාගැනීමට 3 වතාවක් උත්සාහ කිරීම (එක් වරකට තත්පර 5ක් බැගින්)
    for (int i = 0; i < 3; i++) {
      if (getLocalTime(&timeinfo, 5000)) {
        time_synced = true;
        break; // සාර්ථක නම් Loop එකෙන් ඉවත් වේ
      }
      delay(1000); // අසාර්ථක නම් තත්පර 1ක් රැඳී සිට නැවත උත්සාහ කරයි
    }
    
    if (time_synced) {
      if (g_rtcAvailable) {
        rtc.adjust(DateTime(timeinfo.tm_year + 1900, timeinfo.tm_mon + 1, timeinfo.tm_mday, timeinfo.tm_hour, timeinfo.tm_min, timeinfo.tm_sec));
        dispatchLog("NTP_SYNC", "Time synchronized from NTP and RTC updated.");
      }
    } else {
      dispatchLog("NTP_FAIL", "Failed to obtain time from NTP servers after multiple attempts.");
    }
  }
}
